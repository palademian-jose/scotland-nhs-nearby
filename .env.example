# ---- Provider selection -------------------------------------------------
# fake | openrouter | anthropic | openai
# Leave empty for auto: openrouter when OPENROUTER_API_KEY is set, else anthropic/openai when their
# key is set, else fake (deterministic, rule-based; no network).
LLM_PROVIDER=
# Model ids are OpenRouter slugs; the anthropic/openai direct backends strip the vendor prefix.
LLM_MODEL=anthropic/claude-sonnet-5.5
JUDGE_MODEL=openai/gpt-5.4-mini
CHEAP_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=scotland-nhs-nearby
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Data ---------------------------------------------------------------
# Defaults to <repo>/data. Uses data/nhs.duckdb when present, else the committed sample CSVs.
DATA_DIR=
DB_PATH=
# true forces the committed sample even when data/nhs.duckdb exists
USE_SAMPLE=false
# Allow a live postcodes.io lookup for postcodes missing from data/geocode_cache.json
LIVE_GEOCODE=false
POSTCODES_IO_URL=https://api.postcodes.io

# ---- Limits -------------------------------------------------------------
DAILY_COST_CAP_USD=2.0
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ---- Tracing ------------------------------------------------------------
TRACE_PATH=traces/spans.jsonl
# Optional override for the price table (JSON: model id -> {input_per_m, output_per_m})
PRICING_PATH=

# ---- Mobile / web app (read at build time by Expo) ----------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
